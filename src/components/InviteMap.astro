---
import staryMlynLogo from "../assets/stary-mlyn-logo.jpg";

const mapboxTokenEnv = import.meta.env.PUBLIC_MAPBOX_TOKEN;

const defaultVenue = {
  name: "Starý Mlýn u Byšic",
  lat: 50.3071724,
  lng: 14.6305947,
  logo: staryMlynLogo.src,
};

const {
  venue = defaultVenue,
  mapStyle = "mapbox://styles/mapbox/streets-v12",
  mapboxToken = mapboxTokenEnv,
} = Astro.props;
---

{mapboxToken && (
  <link
    rel="stylesheet"
    href="https://api.mapbox.com/mapbox-gl-js/v3.1.2/mapbox-gl.css"
  />
)}
{mapboxToken && (
  <script
    src="https://api.mapbox.com/mapbox-gl-js/v3.1.2/mapbox-gl.js"
    is:inline
  ></script>
)}

<figure class="c-invite-map">
  <div
    class="c-invite-map__canvas"
    data-mapbox-token={mapboxToken}
    data-lat={venue.lat}
    data-lng={venue.lng}
    data-name={venue.name}
    data-logo={venue.logo}
    data-style={mapStyle}
  ></div>
  <figcaption class="c-invite-map__caption">
    <nav class="c-invite-map__nav" aria-label="Navigace">
      <a
        href="https://mapy.com/s/nojebenodu"
        class="c-invite-map__link"
        target="_blank"
        rel="noreferrer"
        title="Navigovat v Mapy.com"
      >
        <svg
          class="c-invite-map__icon"
          viewBox="0 0 17 18"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
        >
          <title>Mapy.com</title>
          <path
            d="M13.6847 3.13566C14.5137 3.56523 15.2838 3.90018 15.6774 4.84826C16.0634 5.7812 15.2686 9.70219 15.2781 12.3212C15.2781 12.4461 15.2781 12.571 15.2762 12.6959C15.3123 13.6326 14.9434 15.4607 14.1562 15.033C13.9014 14.8949 13.5269 14.1114 13.2302 13.2277C12.7492 11.7933 13.1466 8.25074 12.7473 8.17505C12.1236 8.92632 10.4503 10.2604 9.81524 10.673C8.72761 11.3769 8.37965 10.4043 8.18951 9.77221C7.95563 8.99823 7.05244 7.27996 6.87181 7.13803C6.7349 7.03016 6.72349 7.18344 6.69687 7.27428C6.63222 7.49947 6.28616 9.88575 5.91348 11.1896C5.51227 12.5881 4.56345 14.8949 4.12042 15.438C3.67928 15.9811 1.84439 16.4447 1.47551 16.4617C1.23593 16.5185 2.76659 13.3696 3.12977 12.0393C3.64696 10.6711 4.43416 7.5165 4.53493 5.40272C4.6186 4.00994 4.4969 2.70988 4.47979 2.33329C4.47979 1.82803 4.99318 1.55364 5.2803 1.49308C5.61115 1.42496 6.3337 1.29249 7.07336 2.11946C7.50879 2.6058 8.1819 4.22567 8.36824 4.62685C8.60022 5.12833 9.57566 7.39539 9.72207 7.92715C10.2107 7.57517 10.9333 6.86742 11.6653 6.06884C12.4525 5.2097 13.3291 3.76961 13.4261 3.05807C13.5193 3.0259 13.6048 3.09214 13.6866 3.13755"
            fill="currentColor"
          ></path>
        </svg>
        <span>Mapy.com</span>
      </a>
      <a
        href="https://www.waze.com/live-map/directions/cz/stredocesky-kraj/stary-mlyn?place=ChIJtbUU0lnkC0cRAbF5HY6gCtU"
        class="c-invite-map__link"
        target="_blank"
        rel="noreferrer"
        title="Navigovat ve Waze"
      >
        <svg
          role="img"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          class="c-invite-map__icon"
        >
          <title>Waze</title>
          <path
            d="M13.218 0C9.915 0 6.835 1.49 4.723 4.148c-1.515 1.913-2.31 4.272-2.310 6.706v1.739c0 .894-.62 1.738-1.862 1.813-.298.025-.547.224-.547.522-.050.820.820 2.310 2.012 3.502.820.844 1.788 1.515 2.832 2.036a3 3 0 0 0 2.955 3.528 2.966 2.966 0 0 0 2.931-2.385h2.509c.323 1.689 2.086 2.856 3.974 2.210 1.640-.546 2.360-2.409 1.763-3.924a12.84 12.84 0 0 0 1.838-1.465 10.73 10.73 0 0 0 3.180-7.650c0-2.882-1.118-5.589-3.155-7.625A10.899 10.899 0 0 0 13.218 0zm0 1.217c2.558 0 4.967.994 6.780 2.807a9.525 9.525 0 0 1 2.807 6.780A9.526 9.526 0 0 1 20 17.585a9.647 9.647 0 0 1-6.780 2.807h-2.46a3.008 3.008 0 0 0-2.930-2.410 3.03 3.03 0 0 0-2.534 1.367v.024a8.945 8.945 0 0 1-2.410-1.788c-.844-.844-1.316-1.614-1.515-2.110a2.858 2.858 0 0 0 1.441-.846 2.959 2.959 0 0 0 .795-2.036v-1.789c0-2.110.696-4.197 2.012-5.861 1.863-2.385 4.620-3.726 7.600-3.726zm-2.410 5.986a1.192 1.192 0 0 0-1.191 1.192 1.192 1.192 0 0 0 1.192 1.193A1.192 1.192 0 0 0 12 8.395a1.192 1.192 0 0 0-1.192-1.192zm7.204 0a1.192 1.192 0 0 0-1.192 1.192 1.192 1.192 0 0 0 1.192 1.193 1.192 1.192 0 0 0 1.192-1.193 1.192 1.192 0 0 0-1.192-1.192zm-7.377 4.769a.596.596 0 0 0-.546.845 4.813 4.813 0 0 0 4.346 2.757 4.77 4.77 0 0 0 4.347-2.757.596.596 0 0 0-.547-.845h-.025a.561.561 0 0 0-.521.348 3.59 3.59 0 0 1-3.254 2.061 3.591 3.591 0 0 1-3.254-2.061.64.64 0 0 0-.546-.348z"
          ></path>
        </svg>
        <span>Waze</span>
      </a>
      <a
        href="https://maps.app.goo.gl/rPxYQ6JGSvNV6Wrx7"
        class="c-invite-map__link"
        target="_blank"
        rel="noreferrer"
        title="Navigovat v Google Maps"
      >
        <svg
          role="img"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          class="c-invite-map__icon"
        >
          <title>Google Maps</title>
          <path
            d="M19.527 4.799c1.212 2.608.937 5.678-.405 8.173-1.101 2.047-2.744 3.74-4.098 5.614-.619.858-1.244 1.75-1.669 2.727-.141.325-.263.658-.383.992-.121.333-.224.673-.34 1.008-.109.314-.236.684-.627.687h-.007c-.466-.001-.579-.53-.695-.887-.284-.874-.581-1.713-1.019-2.525-.51-.944-1.145-1.817-1.79-2.671L19.527 4.799zM8.545 7.705l-3.959 4.707c.724 1.54 1.821 2.863 2.871 4.18.247.31.494.622.737.936l4.984-5.925-.029.01c-1.741.601-3.691-.291-4.392-1.987a3.377 3.377 0 0 1-.209-.716c-.063-.437-.077-.761-.004-1.198l.001-.007zM5.492 3.149l-.003.004c-1.947 2.466-2.281 5.88-1.117 8.770l4.785-5.689-.058-.05-3.607-3.035zM14.661.436l-3.838 4.563a.295.295 0 0 1 .027-.01c1.6-.551 3.403.15 4.220 1.626.176.319.323.683.377 1.045.068.446.085.773.012 1.220l-.003.016 3.836-4.561A8.382 8.382 0 0 0 14.670.439l-.009-.003zM9.466 5.868L14.162.285l-.047-.012A8.31 8.31 0 0 0 11.986 0a8.439 8.439 0 0 0-6.169 2.766l-.016.018 3.665 3.084z"
          ></path>
        </svg>
        <span>Google Maps</span>
      </a>
      <a
        href="https://maps.apple.com/place?place-id=IA0906048B5D7231E"
        class="c-invite-map__link"
        target="_blank"
        rel="noreferrer"
        title="Navigovat v Apple Maps"
      >
        <svg
          role="img"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          class="c-invite-map__icon"
        >
          <title>Apple Maps</title>
          <path
            d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
          ></path>
        </svg>
        <span>Apple Maps</span>
      </a>
    </nav>
  </figcaption>
</figure>
<script type="module">
const mapElements = document.querySelectorAll(".c-invite-map__canvas");

mapElements.forEach((mapElement) => {
  if (!mapElement || !window.mapboxgl) {
    return;
  }

  const token = mapElement.dataset.mapboxToken;
  const lat = Number(mapElement.dataset.lat);
  const lng = Number(mapElement.dataset.lng);
  const name = mapElement.dataset.name;
  const logo = mapElement.dataset.logo;
  const style = mapElement.dataset.style;

  if (!token) {
    return;
  }

  mapboxgl.accessToken = token;

  const map = new mapboxgl.Map({
    container: mapElement,
    style: style || "mapbox://styles/mapbox/streets-v12",
    center: [lng, lat],
    zoom: 7.5,
    interactive: true,
    pitch: 0,
    bearing: 0,
    attributionControl: false,
  });

  map.dragRotate.disable();
  map.touchZoomRotate.disableRotation();

  map.addControl(
    new mapboxgl.NavigationControl({ showCompass: false }),
    "top-right",
  );

  map.addControl(
    new mapboxgl.AttributionControl({ compact: true }),
    "bottom-right",
  );

  map.on("style.load", () => {
    const layers = map.getStyle().layers ?? [];

    layers.forEach((layer) => {
      map.setLayoutProperty(layer.id, "text-field", [
        "coalesce",
        ["get", "name_cs"],
        ["get", "name"],
      ]);
    });
  });

  const markerElement = document.createElement("div");
  markerElement.className = "c-invite-map__marker";
  if (logo) {
    const img = document.createElement("img");
    img.src = logo;
    img.alt = name;
    markerElement.appendChild(img);
  }

  const label = document.createElement("span");
  label.className = "c-invite-map__label";
  label.textContent = name;
  markerElement.appendChild(label);

  new mapboxgl.Marker({
    element: markerElement,
    anchor: "bottom",
  })
    .setLngLat([lng, lat])
    .addTo(map);
});
</script>
